# Optional credentials and overrides. The Bun CLIs read `.env`; the Python tools read the
# process environment, so `export` those variables instead.
# Copy this file to `.env` (gitignored) and fill in only
# what you use. Never commit `.env`; this example holds no real values.

# adzuna-search (required for that CLI) - free key at https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# jev_fit_check.py / jev_client.py (optional fit-scoring helper)
# TYPESAFE_API_KEY=

# himalayas-search / freehire-search: only to point at a self-hosted or alternate instance
# HIMALAYAS_API_URL=
# FREEHIRE_API_URL=

# tools/gmail_client.py (optional Gmail access; use an app password, never the account password)
# JOB_KIT_GMAIL_ADDRESS=
# JOB_KIT_GMAIL_NAME=
# JOB_KIT_GMAIL_APP_PASSWORD=
